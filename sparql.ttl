@prefix dc: <http://purl.org/dc/terms/> .
@prefix dist: <http://www.w3.org/2007/08/pyRdfa/distiller#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix xhv: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://www.w3.org/ns/sparql/> dc:title "Terms used by SPARQL" ;
     xhv:stylesheet <http://www.w3.org/StyleSheets/TR/base> . 

<http://www.w3.org/ns/sparql#> a owl:Ontology ;
     dc:creator <http://www.ivan-herman.net/foaf#me> ;
     dc:date "2026-11-17" ;
     dc:description "Terms used by SPARQL" ;
     owl:versionInfo "2026-11-17 18:47:00" . 

sparql:version-1.2 dc:title "SPARQL Query and Update version 1.2" ;
     rdfs:isDefinedBy <https://www.w3.org/TR/sparql12-query/#versionLabels> . 

sparql:version-1.2-basic dc:title "SPARQL Query and Update version 1.2-basic" ;
     dc:description "This is a version of SPARQL without triple terms, without triple patterns that have a triple pattern in their subject or object position, but otherwise with all 1.2 features and semantics." ;
     rdfs:isDefinedBy <https://www.w3.org/TR/sparql12-query/#versionLabels> . 

sparql:version-1.1 dc:title "SPARQL Query and Update version 1.1" ;
     rdfs:isDefinedBy <https://www.w3.org/TR/sparql12-query/#versionLabels> . 

sparql:version-1.0 dc:title "SPARQL Query version 1.0" ;
     rdfs:isDefinedBy <https://www.w3.org/TR/sparql12-query/#versionLabels> . 

sparql:bound dc:description "Checks if a variable is bound to a value." ;
     rdfs:isDefinedBy <http://www.w3.org/TR/sparql11-query/#func-bound> . 

<http://www.ivan-herman.net/foaf#me> a foaf:Person ;
     rdfs:seeAlso <http://www.ivan-herman.net/foaf> ;
     foaf:mbox <mailto:ivan@w3.org> ;
     foaf:name "Ivan Herman" ;
     foaf:title "Semantic Web Activity Lead" ;
     foaf:workplaceHomepage <http://www.w3.org> . 
